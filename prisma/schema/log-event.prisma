model LogEvent {
  id          String   @id @default(cuid())

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])

  environment String
  level       String
  event       String

  message     String?

  timestamp   DateTime @default(now())

  payload     Json?

  @@index([projectId])
  @@index([timestamp])
  @@index([projectId, timestamp])

  @@map("log")
}