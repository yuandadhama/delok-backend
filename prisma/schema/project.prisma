// /prisma/schema/project.prisma
model Project {
  id String @id @default(cuid())

  name String

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])


  apiKeys ApiKey[]

  @@map("project")
}

model ApiKey {
  id String @id @default(cuid())

  key String @unique

  projectId String
  project Project @relation(fields: [projectId], references: [id])

  @@map("api_key")
}